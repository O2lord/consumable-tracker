# Copy to .env.local and fill in. Never commit real values.
# Server-only: none of these may be prefixed NEXT_PUBLIC_.

# Supabase Postgres connection string used by the server (Drizzle + postgres.js).
# Local (supabase start):   postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Hosted: Project Settings > Database > Connection string. Use the pooled
# (transaction, port 6543) string for the deployed app; the code sets prepare:false.
DATABASE_URL=postgresql://postgres.<project-ref>:<database-password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Supabase API (needed from Phase 1, when auth is added)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<your-publishable-key>
SUPABASE_SERVICE_ROLE_KEY=<your-secret-key>

# Session / cookie signing
SESSION_SECRET=change-me-to-a-long-random-string

# Field encryption for patient numbers (MRN). REQUIRED in production: the app refuses to start storing or
# reading MRNs without them. Two DIFFERENT keys, each the base64 of 32 random bytes:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep them out of the database and out of git (Netlify environment variables, marked secret). Losing
# FIELD_ENCRYPTION_KEY makes every stored MRN unreadable. Changing FIELD_INDEX_KEY after data exists breaks MRN
# lookups and mismatch checks (the stored fingerprints no longer match) and needs a rebuild script that does
# not exist yet, so treat both keys as permanent. Back both up somewhere safe, apart from the database backups.
FIELD_ENCRYPTION_KEY=
FIELD_INDEX_KEY=

# Label printer (Zebra-class, ZPL over network). Leave empty to use PDF fallback.
PRINTER_HOST=
# The staff portal's address, for "View result" links on the issued-bottle Results tab
PORTAL_BASE_URL=https://uath-staff-staging.betacare.com.ng

# Hours an issued bottle may stay out before it shows as outstanding
OUTSTANDING_HOURS=24

# Where investigations and Pharmacy data come from: csv (the imported files, default) or manual (nothing known).
REFERENCE_PROVIDER=csv
PHARMACY_PROVIDER=csv
